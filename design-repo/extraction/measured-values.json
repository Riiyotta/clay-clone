  "knownGaps": [
    {
      "item": "/integrations searchable list",
      "status": "NOT BUILT — a ~32,000px searchable list the capture pass cannot carry. Deliberately not given a fabricated template. The route resolves to page.product-generic today, which is the shape it falls back to, not the shape the original has.",
      "citation": "HANDOFF.md:287-288"
    },
    {
      "item": "Motion frozen inside captured plates",
      "status": "Widgets baked into a plate do not move: node diagrams, a typing email with skeleton shimmer, a carousel auto-advance and a live counter, and the /about timeline. De-freezing means rebuilding each as live DOM. No section contract in this repo claims live interactivity for a plate-backed band.",
      "citation": "HANDOFF.md:284-290"
    },
