{
  "id": "error.not-found",
  "kind": "section",
  "version": "1.0.0",
  "name": "404 block",
  "category": "error",
  "purpose": "A centred 404 eyebrow, a 64/600 apology heading and a single home button.",
  "tags": [],
  "implementedBy": "src/pages/NotFound.jsx",
