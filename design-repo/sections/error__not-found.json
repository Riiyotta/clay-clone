    "mustBeFirst": true,
    "mustBeLast": true
  },
  "motion": {
    "pattern": "none",
    "trigger": "none",
    "reducedMotionFallback": "static-no-motion",
    "evidence": "Static."
  },
  "responsive": [
    {
      "maxWidth": 767,
      "note": "heading 64 -> 40/42"
    }
  ]
