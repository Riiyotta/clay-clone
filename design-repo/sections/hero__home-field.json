{
  "id": "hero.home-field",
  "kind": "section",
  "version": "1.0.0",
  "name": "Home hero field",
  "category": "hero",
  "purpose": "Full-bleed green field with a looping film, a display H1 and a right-hand intro column anchored to the bottom.",
  "tags": [],
  "implementedBy": "src/components/Hero.jsx",
  "measuredFrom": [
    "src/components/Hero.jsx:1-40",
    "CLONE_SPEC.md:269-314",
    "src/components/HeroField.jsx:1-39"
  ],
  "uses": [
    "primitive.button",
    "primitive.video-poster"
  ],
  "content": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "sub",
      "ctas",
      "film",
      "poster"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxWords": 8
      },
      "sub": {
        "type": "string",
        "maxWords": 20
      },
      "ctas": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "href"
          ],
          "properties": {
            "label": {
              "type": "string",
              "maxWords": 4
            },
            "href": {
              "type": "string",
              "maxWords": 3
            }
          }
        },
        "description": ""
      },
      "film": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetRole",
          "ref"
        ],
        "properties": {
          "assetRole": {
            "const": "product.motion-film"
          },
          "ref": {
            "type": "string",
            "description": "opaque asset reference; never a live third-party URL"
          },
          "alt": {
            "type": "string",
            "maxWords": 12
          }
        },
        "description": "media slot, assetRole product.motion-film"
      },
      "poster": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetRole",
          "ref"
        ],
        "properties": {
          "assetRole": {
            "const": "video.poster"
          },
          "ref": {
            "type": "string",
            "description": "opaque asset reference; never a live third-party URL"
          },
          "alt": {
            "type": "string",
            "maxWords": 12
          }
        },
        "description": "media slot, assetRole video.poster"
      }
    }
  },
  "constraints": {
    "onePerPage": true,
    "mustBeFirst": true,
    "homeRouteOnly": true
  },
  "motion": {
    "pattern": "lazy-video-poster-crossfade",
    "trigger": "intersection-observer",
    "reducedMotionFallback": "poster-only",
    "evidence": "IO #1 starts the film 200px before entry and cross-fades the poster over 300ms ease. The H1 is at opacity 1 / transform none on the first frame — NO hero entrance animation. CLONE_SPEC.md:755-770",
    "durationMs": 300,
    "easing": "ease"
  },
  "responsive": [
    {
      "maxWidth": 991,
      "height": "736px",
      "note": "intro column stacks, margin-bottom drops to 0"
    },
    {
      "maxWidth": 767,
      "height": "704px"
    },
    {
      "maxWidth": 479,
      "height": "640px"
    }
  ],
  "assets": [
    "product.motion-film",
    "video.poster"
  ]
}
