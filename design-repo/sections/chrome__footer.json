{
  "id": "chrome.footer",
  "kind": "section",
  "version": "1.0.0",
  "name": "Site footer",
  "category": "chrome",
  "purpose": "CTA band over a looping film, then an oat panel with a 5-column link grid and a credit bar.",
  "tags": [],
  "implementedBy": "src/components/Footer.jsx",
  "measuredFrom": [
    "src/components/Footer.jsx:1-21",
    "CLONE_SPEC_2.md:778-870",
    "src/App.jsx:89-92"
  ],
  "uses": [
    "primitive.link"
  ],
  "content": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ctaHeading",
      "ctaButtons",
      "columns"
    ],
    "properties": {
      "ctaHeading": {
        "type": "string",
        "maxWords": 10
      },
      "ctaButtons": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "href"
          ],
          "properties": {
            "label": {
              "type": "string",
              "maxWords": 4
            },
            "href": {
              "type": "string",
              "maxWords": 3
            }
          }
        },
        "description": ""
      },
      "columns": {
        "type": "array",
        "minItems": 5,
        "maxItems": 7,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heading",
            "links"
          ],
          "properties": {
            "heading": {
              "type": "string",
              "maxWords": 2
            },
            "links": {
              "type": "array",
              "minItems": 1,
              "maxItems": 14,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "href"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "maxWords": 6
                  },
                  "href": {
                    "type": "string",
                    "maxWords": 3
                  }
                }
              },
              "description": ""
            }
          }
        },
        "description": ""
      },
      "film": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetRole",
          "ref"
        ],
        "properties": {
          "assetRole": {
            "const": "product.motion-film"
          },
          "ref": {
            "type": "string",
            "description": "opaque asset reference; never a live third-party URL"
          },
          "alt": {
            "type": "string",
            "maxWords": 12
          }
        },
        "description": "media slot, assetRole product.motion-film"
      },
      "socials": {
        "type": "array",
        "minItems": 0,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "href"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxWords": 2
            },
            "href": {
              "type": "string",
              "maxWords": 3
            }
          }
        },
        "description": ""
      }
    }
  },
  "constraints": {
    "onePerPage": true,
    "mustNotBePageNode": true,
    "note": "Footer is rendered ONCE outside <Routes>. Captured pages suppress it via html[data-footer='none'] and offset it with --footer-spacer."
  },
  "motion": {
    "pattern": "hover-underline-wipe",
    "trigger": "hover",
    "reducedMotionFallback": "instant-state-change",
    "evidence": "Footer links transition color .1s ease-out (61 occurrences — the most common transition on the page). CLONE_SPEC.md:831",
    "durationMs": 100,
    "easing": "ease-out"
  },
  "responsive": [
    {
      "maxWidth": 991,
      "columns": 3
    },
    {
      "maxWidth": 767,
      "columns": 1
    }
  ],
  "assets": [
    "brand.wordmark",
    "product.motion-film"
  ]
}
