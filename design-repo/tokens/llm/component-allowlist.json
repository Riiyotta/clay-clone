{
  "version": "1.0.0",
  "$description": "The closed set of contracts an AI may instantiate, and the closed set of node properties it may set. Cross-checked against schema/pagespec.schema.json by extraction/verify_all.py — this list is NOT hand-maintained.",
  "settableNodeProperties": {
    "section": "the section contract id — closed enum",
    "variant": "an optional variant string declared by that section's contract",
    "content": "the section's own content object, validated by that section's closed contract",
    "motion": "a motion object drawn from the closed pattern/trigger/fallback enums"
  },
  "mayNotSet": [
    "tokens",
    "measuredFrom",
    "implementedBy",
    "constraints",
    "responsive",
    "css",
    "style",
    "className"
  ],
  "mayNotSetNote": "Styling is owned entirely by the section and component contracts. A PageSpec instance has no per-instance token-override field, so there is nothing at the PageSpec layer to validate token overrides against; token policy is enforced at the catalog/policy layer instead.",
